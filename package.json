{
  "name": "flowshield-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:react": "vite",
    "dev:streamlit": "python -m streamlit run flowshield/app.py --server.port 8501 --server.headless true",
    "dev:all": "concurrently --kill-others-on-fail --prefix-colors \"cyan,magenta\" --names \"REACT,STREAMLIT\" \"npm run dev:react\" \"npm run dev:streamlit\"",
    "build": "tsc && vite build",
    "postbuild": "node -e \"const fs=require('fs'); ['flowshield/static/3d','static/3d'].forEach(dest => { fs.rmSync(dest, {recursive: true, force: true}); fs.cpSync('dist', dest, {recursive: true, force: true}); });\"",
    "start": "python -m streamlit run flowshield/app.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^2.6.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
